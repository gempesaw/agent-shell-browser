{
  "manifest_version": 3,
  "name": "agent-shell-browser",
  "version": "0.1.0",
  "description": "Send a selection or page to an agent-shell session in Emacs.",
  "key": "",
  "permissions": ["contextMenus", "scripting", "activeTab", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to agent-shell"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "agent-shell-browser@gempesaw.github.io",
      "strict_min_version": "128.0"
    }
  }
}
